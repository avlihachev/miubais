diff --git a/internal/jobs/service.go b/internal/jobs/service.go
index bba8bb0..5dd76a7 100644
--- a/internal/jobs/service.go
+++ b/internal/jobs/service.go
@@ -74,3 +74,17 @@ func (s *Service) Cancel(id string) (Job, error) {
 	}
 	return job, nil
 }
+
+func (s *Service) Overdue(at time.Time) ([]Job, error) {
+	inProgress, err := s.List(StatusInProgress)
+	if err != nil {
+		return nil, err
+	}
+	overdue := make([]Job, 0, len(inProgress))
+	for _, job := range inProgress {
+		if job.DueAt != nil && job.DueAt.Before(at) {
+			overdue = append(overdue, job)
+		}
+	}
+	return overdue, nil
+}
diff --git a/internal/jobs/service_test.go b/internal/jobs/service_test.go
index f957278..5c8fc63 100644
--- a/internal/jobs/service_test.go
+++ b/internal/jobs/service_test.go
@@ -82,3 +82,26 @@ func TestParseStatus(t *testing.T) {
 		t.Fatal("archived should not parse")
 	}
 }
+
+func TestOverdueKeepsInProgressPastDueAt(t *testing.T) {
+	repo := store.NewMemory()
+	past, future := fixedNow.Add(-time.Hour), fixedNow.Add(time.Hour)
+	for _, job := range []jobs.Job{
+		{ID: "job-0001", Status: jobs.StatusInProgress, DueAt: &past},
+		{ID: "job-0002", Status: jobs.StatusInProgress, DueAt: &future},
+		{ID: "job-0003", Status: jobs.StatusDelivered, DueAt: &past},
+		{ID: "job-0004", Status: jobs.StatusInProgress},
+	} {
+		if err := repo.Put(job); err != nil {
+			t.Fatal(err)
+		}
+	}
+	svc := jobs.NewService(repo, func() time.Time { return fixedNow })
+	got, err := svc.Overdue(fixedNow)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(got) != 1 || got[0].ID != "job-0001" {
+		t.Fatalf("want only job-0001, got %+v", got)
+	}
+}
