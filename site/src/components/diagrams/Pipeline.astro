---
import Inline from "./Inline.astro";

interface Lane {
  name: string;
  does: string[];
}

interface Step {
  name: string;
  does?: string[];
  branches?: Lane[];
  bound?: string;
  sets?: string;
  loop?: string;
}

interface Props {
  from: string;
  to: string;
  steps: Step[];
  label: string;
  note?: string;
}

const { from, to, steps, label, note } = Astro.props;
const longest = Math.max(...steps.map((s) => s.name.length));
const nameWidth = `${Math.min(13, Math.max(6, longest * 0.62 + 0.5)).toFixed(2)}rem`;
---

<figure class="mg-pipe not-content" aria-label={label} style={`--name: ${nameWidth}`}>
  <p class="end"><Inline text={from} /></p>
  <ol>
    {
      steps.map((s) => (
        <li class:list={{ loop: s.loop, wide: !s.bound && !s.sets }}>
          <span class="name">{s.name}</span>
          <div class="does">
            {s.does?.map((line) => (
              <p>
                <Inline text={line} />
              </p>
            ))}
            {s.branches && (
              <div class="lanes" style={`--lanes: ${s.branches.length}`}>
                {s.branches.map((lane) => (
                  <div class="lane">
                    <p class="lane-name">{lane.name}</p>
                    {lane.does.map((line) => (
                      <p>
                        <Inline text={line} />
                      </p>
                    ))}
                  </div>
                ))}
              </div>
            )}
          </div>
          {(s.bound || s.sets) && (
            <div class="regime">
              {s.bound && (
                <p>
                  <Inline text={s.bound} />
                </p>
              )}
              {s.sets && (
                <p class="sets">
                  sets <Inline text={s.sets} />
                </p>
              )}
            </div>
          )}
          {s.loop && (
            <p class="until">
              loops <Inline text={s.loop} />
            </p>
          )}
        </li>
      ))
    }
  </ol>
  <p class="end"><Inline text={to} /></p>
  {
    note && (
      <figcaption>
        <Inline text={note} />
      </figcaption>
    )
  }
</figure>

<style>
  .mg-pipe {
    --rail: 0.4375rem;
    margin: 1.5rem 0;
    max-width: 72ch;
    color: var(--mg-ink);
    font-size: 0.9375rem;
    line-height: 1.45;
  }
  .mg-pipe p {
    margin: 0;
  }
  .mg-pipe :global(code) {
    font-size: 0.875em;
    padding: 0.0625rem 0.25rem;
    background: var(--mg-code-bg);
    border-radius: 3px;
    overflow-wrap: anywhere;
  }
  .end {
    font-family: var(--sl-font-mono);
    color: var(--mg-mute);
    padding-left: 1.5rem;
    position: relative;
  }
  .end :global(code) {
    background: none;
    padding: 0;
    font-size: inherit;
  }
  .end::before {
    content: "";
    position: absolute;
    left: calc(var(--rail) - 0.1875rem);
    top: 0.5em;
    width: 0.375rem;
    height: 0.375rem;
    border-radius: 50%;
    border: 1px solid var(--mg-mute);
  }
  ol {
    list-style: none;
    margin: 0;
    padding: 0.375rem 0;
  }
  li {
    display: grid;
    grid-template-columns: var(--name) minmax(0, 1fr) 16rem;
    gap: 0.25rem 1.25rem;
    padding: 0.625rem 0 0.625rem 1.5rem;
    position: relative;
  }
  li.wide .does {
    grid-column: 2 / -1;
  }
  li::before {
    content: "";
    position: absolute;
    left: var(--rail);
    top: -0.375rem;
    bottom: -0.375rem;
    border-left: 1px solid var(--mg-rule);
  }
  li::after {
    content: "";
    position: absolute;
    left: calc(var(--rail) - 0.25rem);
    top: 0.95rem;
    width: 0.5rem;
    height: 0.5rem;
    background: var(--mg-ink);
  }
  .name {
    font-family: var(--sl-font-mono);
    font-weight: 500;
  }
  .lanes {
    display: grid;
    grid-template-columns: repeat(var(--lanes), minmax(0, 1fr));
    gap: 0.5rem 1.25rem;
  }
  .lane {
    border-top: 1px solid var(--mg-rule);
    padding-top: 0.25rem;
  }
  .lane-name {
    font-family: var(--sl-font-mono);
    font-size: 0.875rem;
    color: var(--mg-mute);
  }
  .until {
    font-family: var(--sl-font-mono);
    font-size: 0.875rem;
    color: var(--mg-mute);
    grid-column: 2 / -1;
  }
  .regime {
    color: var(--mg-mute);
    border-left: 1px solid var(--mg-rule);
    padding-left: 0.75rem;
  }
  .sets {
    color: var(--mg-ink);
    font-weight: 500;
  }
  li.loop::before {
    border-left-style: dashed;
  }
  figcaption {
    margin-top: 0.75rem;
    color: var(--mg-mute);
    font-size: 0.875rem;
  }
  @media (max-width: 50rem) {
    li {
      grid-template-columns: minmax(0, 1fr);
    }
    li.wide .does,
    .until {
      grid-column: auto;
    }
    .lanes {
      grid-template-columns: minmax(0, 1fr);
    }
    .regime {
      border-left: 0;
      padding-left: 0;
    }
  }
</style>
